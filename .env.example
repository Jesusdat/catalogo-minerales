# Copia este archivo a tu servicio de hosting como variables de entorno.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_ALLOWED_HOSTS=gabinete-mineral.onrender.com
# PostgreSQL (Neon, Supabase, Render…). Sin esta variable se usa SQLite (data.db).
DATABASE_URL=postgresql://usuario:clave@host:5432/basedatos
# Cuenta de administración que se crea o actualiza al desplegar (solo tú).
DJANGO_SUPERUSER_USERNAME=jesusdat
DJANGO_SUPERUSER_EMAIL=tu-correo@ejemplo.com
DJANGO_SUPERUSER_PASSWORD=una-contraseña-larga
# Ruta secreta opcional para el panel (por defecto "admin/").
DJANGO_ADMIN_URL=panel-privado/
